[Unit]
Description=Synchronise CPU time-stamp counters (firmware leaves CPU0 behind)
Documentation=file:/usr/local/src/tscsync/tscsync.c
DefaultDependencies=no
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/usr/local/sbin/tscsync

[Service]
Type=oneshot
ExecStartPre=-/sbin/modprobe msr
ExecStart=/usr/local/sbin/tscsync --apply --quiet
# Never run on an unsynced TSC: if the sync fails for any reason, put the kernel back on HPET.
ExecStopPost=/bin/sh -c 'if [ "$SERVICE_RESULT" != success ]; then echo hpet > /sys/devices/system/clocksource/clocksource0/current_clocksource && echo "tscsync FAILED ($SERVICE_RESULT/$EXIT_STATUS); switched clocksource to hpet"; fi'

[Install]
WantedBy=sysinit.target
